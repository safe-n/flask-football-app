# Skopiuj do .env i uzupełnij. Pliku .env NIGDY nie commitujemy.
API_KEY=wpisz_nowy_klucz
API_HOST=api-football-v1.p.rapidapi.com
# rapidapi (domyślnie) albo apisports (bezpośrednio z dashboard.api-football.com)
API_PROVIDER=rapidapi
# id bukmachera w API-Football (8 = Bet365)
ODDS_BOOKMAKER_ID=8
# ile zapytań zostawić w zapasie z dziennego limitu
REQUEST_RESERVE=5
DB_PATH=data/football.db
CACHE_DIR=data/cache
DEFAULT_LEAGUE=E0

# --- zasilanie bazy przy starcie (deploy). Lokalnie zostaw 0 i używaj fetch-csv.
AUTO_BOOTSTRAP=0
BOOTSTRAP_LEAGUES=auto
BOOTSTRAP_YEARS=4
REFRESH_HOURS=24

# --- historia / archiwum / powiadomienia
HISTORY_DIR=history
ARCHIVE_ODDS=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- football-data.org (darmowy token: football-data.org/client/register) - Liga Mistrzów i zapasowy terminarz
FOOTBALL_DATA_ORG_TOKEN=

# --- trwały dziennik bez GitHub Actions (token z uprawnieniem Contents: Read and write tylko do tego repo)
GITHUB_TOKEN=
GITHUB_REPO=
LEDGER_BRANCH=ledger-data

# --- opcjonalna analiza AI zestawienia (płatna za użycie; wyłączona, dopóki nie ustawisz OBU zmiennych)
ANTHROPIC_API_KEY=
AI_ACCESS_CODE=
AI_MODEL=claude-haiku-5-5
AI_WEB_SEARCH=1
AI_DAILY_LIMIT=20
