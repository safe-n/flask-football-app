# Skopiuj do .env i uzupełnij. Pliku .env NIGDY nie commitujemy.
API_KEY=wpisz_nowy_klucz
API_HOST=api-football-v1.p.rapidapi.com
# rapidapi (domyślnie) albo apisports (bezpośrednio z dashboard.api-football.com)
API_PROVIDER=rapidapi
# id bukmachera w API-Football (8 = Bet365)
ODDS_BOOKMAKER_ID=8
# ile zapytań zostawić w zapasie z dziennego limitu
REQUEST_RESERVE=5
DB_PATH=data/football.db
CACHE_DIR=data/cache
DEFAULT_LEAGUE=E0
